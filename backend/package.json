{
  "name": "nutriplan-backend",
  "version": "1.0.0",
  "description": "NutriPlan REST API — Node.js, Express and MongoDB",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}

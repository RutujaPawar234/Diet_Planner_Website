# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
# Local:  mongodb://127.0.0.1:27017/nutriplan
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nutriplan?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nutriplan

# ---------- Auth ----------
# Use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# Frontend origin(s) allowed to call the API. Comma-separate multiple values.
CLIENT_URL=http://localhost:5173

# ---------- Seed accounts (npm run seed / npm run seed:demo) ----------
# Change these before seeding a deployed database.
ADMIN_NAME=NutriPlan Admin
ADMIN_EMAIL=admin@nutriplan.app
ADMIN_PASSWORD=Admin@12345
DEMO_EMAIL=demo@nutriplan.app
DEMO_PASSWORD=Demo@12345

# Optional: public DNS for mongodb+srv lookups (fixes querySrv ECONNREFUSED on some networks)
# DNS_SERVERS=8.8.8.8,1.1.1.1
